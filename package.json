{
  "name": "@thefurdui/wic",
  "version": "1.4.0",
  "description": "A CLI tool that generates wide-gamut (Display P3) web assets and safely converts them to legacy sRGB favicons from a single SVG source.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "wic": "index.js"
  },
  "files": [
    "index.js",
    "browser.js"
  ],
  "scripts": {
    "start": "node index.js",
    "install:global": "pnpm install --frozen-lockfile && pnpm add --global .",
    "test": "node --test"
  },
  "dependencies": {
    "png-to-ico": "^3.0.1",
    "puppeteer": "^25.11.0"
  },
  "author": "Andrei Furdui",
  "license": "MIT"
}
